{
    "name": "nicoren/cron-bundle",
    "type": "symfony-bundle",
    "description": "Symfony cron",
    "license": "MIT",
    "authors": [
        {
            "name": "Nicolas RENAULT",
            "email": "nicoren44@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "doctrine/persistence": "^3.2 || ^4.0",
        "symfony/config": "^7.4 || ^8.0",
        "symfony/console": "^7.4 || ^8.0",
        "symfony/dependency-injection": "^7.4 || ^8.0",
        "symfony/filesystem": "^7.4 || ^8.0",
        "symfony/finder": "^7.4 || ^8.0",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "symfony/http-kernel": "^7.4 || ^8.0",
        "symfony/process": "^7.4 || ^8.0",
        "symfony/validator": "^7.4 || ^8.0"
    },
    "require-dev": {
        "doctrine/doctrine-bundle": "^2.13 || ^3.0",
        "doctrine/mongodb-odm-bundle": "^5.0",
        "doctrine/orm": "^3.3",
        "phpunit/phpunit": "^12.0",
        "symfony/yaml": "^7.4 || ^8.0"
    },
    "suggest": {
        "doctrine/doctrine-bundle": "To store jobs with Doctrine ORM (db_driver: orm)",
        "doctrine/mongodb-odm-bundle": "To store jobs with Doctrine MongoDB ODM (db_driver: mongodb)",
        "ext-redis": "To store running pids in Redis (storage.adapter: redis)"
    },
    "autoload": {
        "psr-4" : {
            "Nicoren\\CronBundle\\" : "src/"
        }
    },
    "autoload-dev": {
        "psr-4": { "Nicoren\\CronBundle\\Tests\\": "tests/" }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.0-dev"
        }
    }
}
